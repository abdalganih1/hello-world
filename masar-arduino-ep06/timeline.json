   "t0": 101.831,
   "t1": 105.958,
   "sfx": "click"
  },
  {
   "i": 19,
   "scene": "resistance",
   "text": "تظهر: مئتان وثمانية عشر أوم. قريبة من مئتين وعشرين، وهذا طبيعي.",
   "t0": 106.358,
   "t1": 112.775,
   "sfx": "ding"
  },
  {

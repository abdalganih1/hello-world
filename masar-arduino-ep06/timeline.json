 "lines": [
  {
   "i": 0,
   "scene": "hook",
   "text": "في يدك مقاوم صغير، عليه خطوط ملونة… فكم أوم قيمته؟",
   "t0": 0.6,
   "t1": 6.05,
   "sfx": "rise"
  },
  {
   "i": 1,
   "scene": "hook",
   "text": "وكيف تعرف أن الأردوينو يعطي خمسة فولت فعلا؟ اليوم، نتعلم القياس.",
   "t0": 6.45,
   "t1": 12.139,
   "sfx": "hit"
  },
  {
   "i": 2,
   "scene": "title",
   "text": "الحلقة السادسة: أدوات المهندس.",
   "t0": 13.339,
   "t1": 16.337,
   "sfx": "whoosh"
  },
  {
   "i": 3,
   "scene": "title",
   "text": "وقاعدة اليوم بسيطة: قس… قبل أن توصل.",
   "t0": 16.737,
   "t1": 20.589,
   "sfx": "ding"
  },
  {
   "i": 4,
   "scene": "meter",
   "text": "هذا جهاز القياس، واسمه Multimeter، أي جهاز يقيس أشياء كثيرة.",
   "t0": 21.789,
   "t1": 27.664,
   "sfx": "pop"
  },
  {
   "i": 5,
   "scene": "meter",
   "text": "في أعلاه شاشة، وفي وسطه قرص نختار به ما نريد قياسه.",
   "t0": 28.064,
   "t1": 33.7,
   "sfx": "click"
  },
  {
   "i": 6,
   "scene": "meter",
   "text": "وله سلكان: الأحمر للموجب، والأسود للسالب.",
   "t0": 34.1,
   "t1": 38.783,
   "sfx": "pop"
  },
  {
   "i": 7,
   "scene": "meter",
   "text": "السلك الأسود يدخل دائما في المنفذ COM.",
   "t0": 39.183,
   "t1": 43.292,
   "sfx": "click"
  },
  {
   "i": 8,
   "scene": "meter",
   "text": "والأحمر في المنفذ الذي عليه حرف V، ورمز الأوم.",
   "t0": 43.692,
   "t1": 47.94,
   "sfx": "click"
  },
  {
   "i": 9,
   "scene": "voltage",
   "text": "لنقيس الجهد، ندير القرص إلى حرف V، وبجانبه خط مستقيم.",
   "t0": 49.14,
   "t1": 54.733,
   "sfx": "click"
  },
  {
   "i": 10,
   "scene": "voltage",
   "text": "هذا الخط يعني: جهد مستمر، مثل جهد البطارية والأردوينو.",
   "t0": 55.133,
   "t1": 60.223,
   "sfx": "pop"
  },
  {
   "i": 11,
   "scene": "voltage",
   "text": "ثم نختار رقما أكبر من الجهد الذي نتوقعه، مثل عشرين فولت.",
   "t0": 60.623,
   "t1": 65.643,
   "sfx": "click"
  },
  {
   "i": 12,
   "scene": "voltage",
   "text": "نلمس بالسلك الأحمر قطب خمسة فولت في الأردوينو، وبالأسود قطب GND.",
   "t0": 66.043,
   "t1": 71.782,
   "sfx": "zap"
  },
  {
   "i": 13,
   "scene": "voltage",
   "text": "وتظهر على الشاشة: أربعة فاصلة تسعة وتسعون… أي خمسة فولت تقريبا.",
   "t0": 72.182,
   "t1": 78.28,
   "sfx": "ding"
  },
  {
   "i": 14,
   "scene": "voltage",
   "text": "وإذا ظهرت إشارة سالب، فأنت عكست السلكين فقط. لا مشكلة.",

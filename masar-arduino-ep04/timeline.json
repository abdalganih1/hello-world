 "lines": [
  {
   "i": 0,
   "scene": "hook",
   "text": "لماذا يحترق ضوء صغير… إذا وصلناه بالكهرباء مباشرة؟",
   "t0": 0.6,
   "t1": 5.322,
   "sfx": "hit"
  },
  {
   "i": 1,
   "scene": "hook",
   "text": "الجواب في ثلاث كلمات: الجهد، والتيار، والمقاومة.",
   "t0": 5.722,
   "t1": 10.954,
   "sfx": "rise"
  },
  {
   "i": 2,
   "scene": "title",
   "text": "الحلقة رقم أربعة: الكهرباء… ببساطة.",
   "t0": 12.154,
   "t1": 15.881,
   "sfx": "whoosh"
  },
  {
   "i": 3,
   "scene": "title",
   "text": "لا نحتاج أي قطع اليوم أيضا. سنفهم الفكرة بالماء أولا.",
   "t0": 16.281,
   "t1": 20.832,
   "sfx": "ding"
  },
  {
   "i": 4,
   "scene": "water",
   "text": "تخيل خزان ماء فوق سطح البيت، وأنبوبا ينزل منه.",
   "t0": 22.032,
   "t1": 26.524,
   "sfx": "whoosh"
  },
  {
   "i": 5,
   "scene": "water",
   "text": "الماء يتحرك لأن هناك ضغطا يدفعه.",
   "t0": 26.924,
   "t1": 30.251,
   "sfx": "pop"
  },
  {
   "i": 6,
   "scene": "water",
   "text": "وكمية الماء التي تمر في كل ثانية… هي الجريان.",
   "t0": 30.651,
   "t1": 35.082,
   "sfx": "pop"
  },
  {
   "i": 7,
   "scene": "water",
   "text": "وإذا ضيقنا الأنبوب، يقل الجريان.",
   "t0": 35.482,
   "t1": 38.824,
   "sfx": "hit"
  },
  {
   "i": 8,
   "scene": "voltage",
   "text": "في الكهرباء، الضغط اسمه الجهد، Voltage، ورمزه الحرف V.",
   "t0": 40.024,
   "t1": 45.826,
   "sfx": "whoosh"
  },
  {
   "i": 9,
   "scene": "voltage",
   "text": "ويقاس بوحدة اسمها: فولت.",
   "t0": 46.226,
   "t1": 48.959,
   "sfx": "ding"
  },
  {
   "i": 10,
   "scene": "voltage",
   "text": "بطارية الريموت فيها واحد ونصف فولت تقريبا، والأردوينو يعطي خمسة فولت.",
   "t0": 49.359,
   "t1": 54.864,
   "sfx": "pop"
  },
  {
   "i": 11,
   "scene": "voltage",
   "text": "أما كهرباء البيت، فمئتان وعشرون فولت. وهي خطيرة جدا… لا نلمسها أبدا.",
   "t0": 55.264,
   "t1": 61.57,
   "sfx": "hit"
  },
  {
   "i": 12,
   "scene": "current",
   "text": "والجريان اسمه التيار، Current، ورمزه الحرف I.",
   "t0": 62.77,
   "t1": 67.69,
   "sfx": "whoosh"
  },
  {
   "i": 13,
   "scene": "current",
   "text": "ووحدته هي الأمبير.",
   "t0": 68.09,
   "t1": 69.97,
   "sfx": "ding"
  },
  {
   "i": 14,
   "scene": "current",
   "text": "وهو كمية الكهرباء التي تمر في السلك كل ثانية.",
   "t0": 70.37,
   "t1": 74.542,
   "sfx": "pop"
  },
  {
   "i": 15,
   "scene": "current",
   "text": "والتيار في مشاريعنا صغير جدا، لذلك نقيسه بالملي أمبير، أي جزء من ألف من الأمبير.",
   "t0": 74.942,
   "t1": 82.559,
   "sfx": "pop"
  },
  {
   "i": 16,
   "scene": "resistance",
   "text": "والتضييق اسمه المقاومة، Resistance، ورمزها الحرف R.",
   "t0": 83.759,
   "t1": 89.209,
   "sfx": "whoosh"
  },
  {
   "i": 17,
   "scene": "resistance",
   "text": "وتقاس بوحدة اسمها أوم، ورمزها هذا الحرف اليوناني: أوميغا.",
   "t0": 89.609,
   "t1": 95.373,
   "sfx": "ding"
  },
  {
   "i": 18,
   "scene": "resistance",
   "text": "المقاومة تصعب مرور التيار… مثل أنبوب ضيق.",
   "t0": 95.773,
   "t1": 100.061,
   "sfx": "pop"
  },
  {
   "i": 19,
   "scene": "resistance",
   "text": "وهناك قطعة صغيرة اسمها المقاوم. وظيفتها أن تضع مقاومة محددة في الدارة.",
   "t0": 100.461,
   "t1": 107.62,
   "sfx": "ding"
  },
  {
   "i": 20,
   "scene": "ohm",
   "text": "والآن، العلاقة بين الثلاثة… اسمها قانون أوم.",
   "t0": 108.82,
   "t1": 113.168,
   "sfx": "whoosh"
  },
  {
   "i": 21,
   "scene": "ohm",
   "text": "الجهد يساوي التيار ضرب المقاومة.",
   "t0": 113.568,
   "t1": 116.641,
   "sfx": "ding"
  },
  {
   "i": 22,
   "scene": "ohm",
   "text": "إذا زاد الجهد، والمقاومة ثابتة… يزيد التيار.",
   "t0": 117.041,
   "t1": 121.301,
   "sfx": "pop"
  },
  {
   "i": 23,
   "scene": "ohm",
   "text": "وإذا زادت المقاومة، والجهد ثابت… يقل التيار.",
   "t0": 121.701,
   "t1": 126.071,
   "sfx": "pop"
  },
  {
   "i": 24,
   "scene": "ohm",
   "text": "مثال: خمسة فولت، ومقاومة ألف أوم… فالتيار خمسة ملي أمبير.",
   "t0": 126.471,
   "t1": 132.447,
   "sfx": "ding"
  },
  {
   "i": 25,
   "scene": "ohm",
   "text": "ولهذا… إذا وصلنا الضوء مباشرة بلا مقاومة، يمر تيار كبير جدا… فيحترق.",
   "t0": 132.847,
   "t1": 140.001,
   "sfx": "hit"
  },
  {
   "i": 26,
   "scene": "circuit",
   "text": "الآن، لنر الصورة كاملة: الدارة الكهربائية.",
   "t0": 141.201,
   "t1": 145.295,
   "sfx": "whoosh"
  },
  {
   "i": 27,
   "scene": "circuit",
   "text": "أولا: المصدر، مثل البطارية أو الأردوينو. هو الذي يعطي الجهد.",
   "t0": 145.695,
   "t1": 151.238,
   "sfx": "ding"
  },
  {
   "i": 28,
   "scene": "circuit",
   "text": "ثانيا: الحمل، أي القطعة التي تستهلك الكهرباء، مثل الضوء أو المحرك.",
   "t0": 151.638,
   "t1": 158.17,
   "sfx": "ding"
  },
  {
   "i": 29,
   "scene": "circuit",
   "text": "ثالثا: الأسلاك، أي الطريق الذي يمر فيه التيار.",
   "t0": 158.57,
   "t1": 163.346,
   "sfx": "ding"
  },
  {
   "i": 30,
   "scene": "circuit",
   "text": "والتيار يخرج من الطرف الموجب، ويعود إلى الطرف السالب، واسمه GND، أي الأرضي.",
   "t0": 163.746,
   "t1": 170.958,
   "sfx": "zap"
  },
  {
   "i": 31,
   "scene": "closed",
   "text": "وهنا أهم قاعدة: الدارة يجب أن تكون مغلقة… أي طريقا كاملا بلا انقطاع.",
   "t0": 172.158,
   "t1": 179.194,
   "sfx": "whoosh"
  },
  {
   "i": 32,
   "scene": "closed",
   "text": "إذا انقطع السلك في أي مكان، يتوقف التيار… وينطفئ الضوء.",
   "t0": 179.594,
   "t1": 184.83,
   "sfx": "hit"
  },
  {
   "i": 33,
   "scene": "closed",
   "text": "مثل حلبة سباق: إذا انقطع الطريق، لا يكمل أحد السباق.",
   "t0": 185.23,
   "t1": 190.169,
   "sfx": "pop"
  },
  {
   "i": 34,
   "scene": "puzzle",
   "text": "الآن، لغز: عندك خمسة فولت، وتريد تيارا قدره عشرون ملي أمبير. كم أوم تحتاج؟",

   "t0": 135.638,
   "t1": 140.152,
   "sfx": "pop"
  },
  {
   "i": 26,
   "scene": "structure",
   "text": "ولكل قسم قوسان معقوفان. كل ما بينهما يتبع هذا القسم… مثل صندوق.",
   "t0": 140.552,
   "t1": 147.618,
   "sfx": "click"
  },
  {
   "i": 27,
   "scene": "function",

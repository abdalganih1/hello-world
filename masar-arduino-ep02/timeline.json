 "lines": [
  {
   "i": 0,
   "scene": "hook",
   "text": "في الحلقة الماضية، وعدناكم بأول ضوء.",
   "t0": 0.6,
   "t1": 4.117,
   "sfx": "rise"
  },
  {
   "i": 1,
   "scene": "hook",
   "text": "لكن قبل أن نتحدث مع الأردوينو… يجب أن نتعلم لغته.",
   "t0": 4.517,
   "t1": 9.016,
   "sfx": "pop"
  },
  {
   "i": 2,
   "scene": "hook",
   "text": "وفي هذه الحلقة، ستفهم كل كلمة في أول برنامج ستكتبه.",
   "t0": 9.416,
   "t1": 14.34,
   "sfx": "hit"
  },
  {
   "i": 3,
   "scene": "title",
   "text": "الحلقة الثانية: لغة الأردوينو.",
   "t0": 15.54,
   "t1": 18.449,
   "sfx": "whoosh"
  },
  {
   "i": 4,
   "scene": "title",
   "text": "لا تحتاج أي لوحة أو أي قطعة. تحتاج تركيزك فقط.",
   "t0": 18.849,
   "t1": 23.725,
   "sfx": "ding"
  },
  {
   "i": 5,
   "scene": "program",
   "text": "أولا: ما هو البرنامج؟",
   "t0": 24.925,
   "t1": 27.051,
   "sfx": "whoosh"
  },
  {
   "i": 6,
   "scene": "program",
   "text": "البرنامج هو مجموعة تعليمات، مكتوبة بترتيب.",
   "t0": 27.451,
   "t1": 31.668,
   "sfx": "pop"
  },
  {
   "i": 7,
   "scene": "program",
   "text": "مثل وصفة طبخ: اكسر البيضة، ثم اخفقها، ثم ضعها في المقلاة.",
   "t0": 32.068,
   "t1": 37.892,
   "sfx": "pop"
  },
  {
   "i": 8,
   "scene": "program",
   "text": "إذا غيرت الترتيب، تفسد الطبخة.",
   "t0": 38.292,
   "t1": 41.105,
   "sfx": "hit"
  },
  {
   "i": 9,
   "scene": "program",
   "text": "والأردوينو ينفذ تعليماتك بالترتيب، وحرفيا. لا يخمن، ولا يجتهد.",
   "t0": 41.505,
   "t1": 47.56,
   "sfx": "ding"
  },
  {
   "i": 10,
   "scene": "language",
   "text": "لكن الأردوينو لا يفهم إلا لغة واحدة: صفر وواحد.",
   "t0": 48.76,
   "t1": 53.543,
   "sfx": "whoosh"
  },
  {
   "i": 11,
   "scene": "language",
   "text": "ونحن لا نستطيع أن نكتب بالأصفار والآحاد.",
   "t0": 53.943,
   "t1": 57.328,
   "sfx": "pop"
  },
  {
   "i": 12,
   "scene": "language",
   "text": "لذلك نكتب بلغة قريبة من الإنكليزية، اسمها Arduino C++.",
   "t0": 57.728,
   "t1": 63.828,
   "sfx": "ding"
  },
  {
   "i": 13,
   "scene": "language",
   "text": "ثم يأتي برنامج يترجمها إلى لغة اللوحة. اسمه Compiler، أي المترجم.",
   "t0": 64.228,
   "t1": 70.417,
   "sfx": "zap"
  },
  {
   "i": 14,
   "scene": "language",
   "text": "مثل مترجم بين شخصين، لا يتكلمان اللغة نفسها.",
   "t0": 70.817,
   "t1": 75.011,
   "sfx": "pop"
  },
  {
   "i": 15,
   "scene": "rules",
   "text": "وكأي لغة، لها قواعد. لنتعرف على أهمها.",
   "t0": 76.211,
   "t1": 80.642,
   "sfx": "whoosh"
  },
  {
   "i": 16,
   "scene": "rules",
   "text": "القاعدة الأولى: كل تعليمة تنتهي بفاصلة منقوطة.",
   "t0": 81.042,
   "t1": 85.887,
   "sfx": "ding"
  },
  {
   "i": 17,
   "scene": "rules",
   "text": "مثل النقطة في آخر الجملة. إذا نسيتها، لا يعرف المترجم أين انتهت التعليمة.",
   "t0": 86.287,
   "t1": 92.342,
   "sfx": "pop"
  },
  {
   "i": 18,
   "scene": "rules",
   "text": "القاعدة الثانية: الحروف الكبيرة والصغيرة مختلفة.",
   "t0": 92.742,
   "t1": 97.252,
   "sfx": "ding"
  },
  {
   "i": 19,
   "scene": "rules",
   "text": "كلمة digitalWrite بحرف W كبير صحيحة. أما بحرف w صغير، فهي كلمة لا يعرفها.",
   "t0": 97.652,
   "t1": 105.733,
   "sfx": "click"
  },
  {
   "i": 20,
   "scene": "rules",
   "text": "لماذا؟ لأن من صمموا لغة الأردوينو سموا هذا الأمر بهذا الشكل بالضبط: digital، ثم Write بحرف كبير. والمترجم لا يعرف إلا الاسم كما سجلوه.",
   "t0": 106.133,
   "t1": 118.121,
   "sfx": "ding"
  },
  {
   "i": 21,
   "scene": "rules",
   "text": "مثل اسم شخص: إذا كتبته خطأ، لن يرد عليك.",
   "t0": 118.521,
   "t1": 122.754,
   "sfx": "pop"
  },
  {
   "i": 22,
   "scene": "structure",
   "text": "الآن، أهم شيء: كل برنامج أردوينو له قسمان.",
   "t0": 123.954,
   "t1": 128.31,
   "sfx": "whoosh"
  },
  {
   "i": 23,
   "scene": "structure",
   "text": "القسم الأول اسمه setup. ينفذ مرة واحدة فقط، عندما تبدأ اللوحة.",
   "t0": 128.71,
   "t1": 135.091,
   "sfx": "ding"
  },
  {
   "i": 24,
   "scene": "structure",
   "text": "مثل تجهيز الغرفة قبل الحفلة: مرة واحدة، في البداية.",
   "t0": 135.491,
   "t1": 140.28,
   "sfx": "pop"
  },
  {
   "i": 25,
   "scene": "structure",
   "text": "والقسم الثاني اسمه loop. يعيد نفسه من البداية، مرة بعد مرة، بلا توقف.",
   "t0": 140.68,
   "t1": 147.819,
   "sfx": "ding"
  },
  {
   "i": 26,
   "scene": "structure",
   "text": "مثل دقات القلب: لا تتوقف ما دامت الكهرباء موجودة.",
   "t0": 148.219,
   "t1": 152.733,
   "sfx": "pop"
  },
  {
   "i": 27,
   "scene": "structure",
   "text": "ولكل قسم قوسان معقوفان. كل ما بينهما يتبع هذا القسم… مثل صندوق.",
   "t0": 153.133,
   "t1": 160.199,
   "sfx": "click"
  },
  {
   "i": 28,
   "scene": "function",

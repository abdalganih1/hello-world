 "lines": [
  {
   "i": 0,
   "scene": "hook",
   "text": "في الحلقة الماضية، وعدناكم بأول ضوء.",
   "t0": 0.6,
   "t1": 4.117,
   "sfx": "rise"
  },
  {
   "i": 1,
   "scene": "hook",
   "text": "لكن قبل أن نتحدث مع الأردوينو… يجب أن نتعلم لغته.",
   "t0": 4.517,
   "t1": 9.016,
   "sfx": "pop"
  },
  {
   "i": 2,
   "scene": "hook",
   "text": "وفي هذه الحلقة، ستفهم كل كلمة في أول برنامج ستكتبه.",
   "t0": 9.416,
   "t1": 14.33,
   "sfx": "hit"
  },
  {
   "i": 3,
   "scene": "title",
   "text": "الحلقة الثانية: لغة الأردوينو.",
   "t0": 15.53,
   "t1": 18.439,
   "sfx": "whoosh"
  },
  {
   "i": 4,
   "scene": "title",
   "text": "لا تحتاج أي لوحة أو أي قطعة. تحتاج تركيزك فقط.",
   "t0": 18.839,
   "t1": 23.715,
   "sfx": "ding"
  },
  {
   "i": 5,
   "scene": "program",
   "text": "أولا: ما هو البرنامج؟",
   "t0": 24.915,
   "t1": 27.041,
   "sfx": "whoosh"
  },
  {
   "i": 6,
   "scene": "program",
   "text": "البرنامج هو مجموعة تعليمات، مكتوبة بترتيب.",
   "t0": 27.441,
   "t1": 31.658,
   "sfx": "pop"
  },
  {
   "i": 7,
   "scene": "program",
   "text": "مثل وصفة طبخ: اكسر البيضة، ثم اخفقها، ثم ضعها في المقلاة.",
   "t0": 32.058,
   "t1": 37.882,
   "sfx": "pop"
  },
  {
   "i": 8,
   "scene": "program",
   "text": "إذا غيرت الترتيب، تفسد الطبخة.",
   "t0": 38.282,
   "t1": 41.057,
   "sfx": "hit"
  },
  {
   "i": 9,
   "scene": "program",
   "text": "والأردوينو ينفذ تعليماتك بالترتيب، وحرفيا. لا يخمن، ولا يجتهد.",
   "t0": 41.457,
   "t1": 47.513,
   "sfx": "ding"
  },
  {
   "i": 10,
   "scene": "language",
   "text": "لكن الأردوينو لا يفهم إلا لغة واحدة: صفر وواحد.",
   "t0": 48.713,
   "t1": 53.496,
   "sfx": "whoosh"
  },
  {
   "i": 11,
   "scene": "language",
   "text": "ونحن لا نستطيع أن نكتب بالأصفار والآحاد.",
   "t0": 53.896,
   "t1": 57.28,
   "sfx": "pop"
  },
  {
   "i": 12,
   "scene": "language",
   "text": "لذلك نكتب بلغة قريبة من الإنكليزية، اسمها Arduino C++.",
   "t0": 57.68,
   "t1": 63.78,
   "sfx": "ding"
  },
  {
   "i": 13,
   "scene": "language",
   "text": "ثم يأتي برنامج يترجمها إلى لغة اللوحة. اسمه Compiler، أي المترجم.",
   "t0": 64.18,
   "t1": 70.369,
   "sfx": "zap"
  },
  {
   "i": 14,
   "scene": "language",
   "text": "مثل مترجم بين شخصين، لا يتكلمان اللغة نفسها.",
   "t0": 70.769,
   "t1": 74.964,
   "sfx": "pop"
  },
  {
   "i": 15,
   "scene": "rules",
   "text": "وكأي لغة، لها قواعد. لنتعرف على أهمها.",
   "t0": 76.164,
   "t1": 80.594,
   "sfx": "whoosh"
  },
  {
   "i": 16,
   "scene": "rules",
   "text": "القاعدة الأولى: كل تعليمة تنتهي بفاصلة منقوطة.",
   "t0": 80.994,
   "t1": 85.84,
   "sfx": "ding"
  },
  {
   "i": 17,
   "scene": "rules",
   "text": "مثل النقطة في آخر الجملة. إذا نسيتها، لا يعرف المترجم أين انتهت التعليمة.",
   "t0": 86.24,
   "t1": 92.294,
   "sfx": "pop"
  },
  {
   "i": 18,
   "scene": "rules",
   "text": "القاعدة الثانية: الحروف الكبيرة والصغيرة مختلفة.",
   "t0": 92.694,
   "t1": 97.205,
   "sfx": "ding"
  },
  {
   "i": 19,
   "scene": "rules",
   "text": "كلمة digitalWrite بحرف W كبير صحيحة. أما بحرف w صغير، فهي كلمة لا يعرفها.",
   "t0": 97.605,
   "t1": 105.685,
   "sfx": "click"
  },
  {
   "i": 20,
   "scene": "rules",
   "text": "مثل اسم شخص: إذا كتبته خطأ، لن يرد عليك.",
   "t0": 106.085,
   "t1": 110.318,
   "sfx": "pop"
  },
  {
   "i": 21,
   "scene": "structure",
   "text": "الآن، أهم شيء: كل برنامج أردوينو له قسمان.",
   "t0": 111.518,
   "t1": 115.729,
   "sfx": "whoosh"
  },
  {
   "i": 22,
   "scene": "structure",
   "text": "القسم الأول اسمه setup. ينفذ مرة واحدة فقط، عندما تبدأ اللوحة.",
   "t0": 116.129,
   "t1": 122.511,
   "sfx": "ding"
  },
  {
   "i": 23,
   "scene": "structure",
   "text": "مثل تجهيز الغرفة قبل الحفلة: مرة واحدة، في البداية.",
   "t0": 122.911,
   "t1": 127.699,
   "sfx": "pop"
  },
  {
   "i": 24,
   "scene": "structure",
   "text": "والقسم الثاني اسمه loop. يعيد نفسه من البداية، مرة بعد مرة، بلا توقف.",
   "t0": 128.099,
   "t1": 135.238,
   "sfx": "ding"
  },
  {
   "i": 25,
   "scene": "structure",
